ANTHROPIC_API_KEY=
NEBIUS_API_KEY=               # Nebius AI Studio Token Factory; takes priority over
                              # ANTHROPIC_API_KEY (LLM) and OPENAI_API_KEY (embeddings) when set
LANGCHAIN_API_KEY=          # LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=trade-coach
PINECONE_API_KEY=
PINECONE_ENV=
PINECONE_INDEX_NEWS=trade-coach-news
PINECONE_INDEX_CONCEPTS=trade-coach-concepts
PINECONE_INDEX_PATTERNS=trade-coach-patterns
SQLITE_PATH=./db/trade_coach.db
NEWS_API_KEY=                # Finnhub API key, for news retrieval source

# When any of the keys above are blank, the app falls back to local stand-ins
# (in-memory vector store, fixed FIFO classification, no tracing) so every
# phase can be developed and tested offline. Fill these in when you're ready
# to run against live services.
